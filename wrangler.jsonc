{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analotic-job",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_P-a0Tg_rx1w5hlUETX8JsQ_hghDH_Ag",
    "NEXT_PUBLIC_SUPABASE_URL": "https://qhzhitcrtzhleqxnsrzy.supabase.co"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "analotic-job"
    }
  ],
  "observability": {
    "enabled": true
  }
}
